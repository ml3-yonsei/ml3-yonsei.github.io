{% assign talks = site.data.talks | sort: 'date' | reverse %}
{% assign current_month = site.time | date: '%Y-%m' %}
{% if talks.size > 0 %}
  {% assign current_year = '' %}
  {% for talk in talks %}
    {% if talk.date_precision == 'month' %}
      {% assign talk_sort_date = talk.date | append: '-01' %}
      {% assign talk_datetime = talk.date %}
      {% assign talk_display_date = talk_sort_date | date: '%b' %}
    {% else %}
      {% assign talk_sort_date = talk.date %}
      {% assign talk_datetime = talk.date | date: '%Y-%m-%d' %}
      {% assign talk_display_date = talk.date | date: '%b %d' %}
    {% endif %}
    {% assign talk_year = talk_sort_date | date: '%Y' %}
    {% assign talk_month = talk_sort_date | date: '%Y-%m' %}
    {% if talk_year != current_year %}
      {% unless forloop.first %}
        </ol>
        </section>
      {% endunless %}
      <section class="talk-year" aria-labelledby="talk-year-{{ talk_year }}">
        <h3 id="talk-year-{{ talk_year }}">{{ talk_year }}</h3>
        <ol class="talk-list">
          {% assign current_year = talk_year %}
    {% endif %}
    <li class="talk-entry">
      <time class="talk-date" datetime="{{ talk_datetime | escape }}">
        {{- talk_display_date -}}
        {%- if talk_month > current_month -%}
          <span class="talk-upcoming">Upcoming</span>
        {%- endif -%}
      </time>
      <div class="talk-details">
        <h4>{{ talk.title | escape }}</h4>
        <p class="talk-host">
          {{ talk.host | escape -}}
          {%- if talk.location and talk.location != '' -%}
            <span class="talk-location"> · {{ talk.location | escape }}</span>
          {%- endif %}
        </p>
        {% assign slides_url = talk.slides_url | default: '' | strip %}
        {% assign video_url = talk.video_url | default: '' | strip %}
        {% if slides_url != '' or video_url != '' %}
          <div class="talk-links">
            {% if slides_url != '' %}
              <a
                class="lab-resource-link"
                href="{{ slides_url | escape }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Slides for {{ talk.title | escape }} (opens in a new tab)"
                >Slides <span aria-hidden="true">↗</span></a
              >
            {% endif %}
            {% if video_url != '' %}
              <a
                class="lab-resource-link"
                href="{{ video_url | escape }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Video for {{ talk.title | escape }} (opens in a new tab)"
                >Video <span aria-hidden="true">↗</span></a
              >
            {% endif %}
          </div>
        {% endif %}
      </div>
    </li>
    {% if forloop.last %}
      </ol>
      </section>
    {% endif %}
  {% endfor %}
{% else %}
  <p>Recent talks, slides, and recordings will be shared here.</p>
{% endif %}
